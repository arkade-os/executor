{
  "format": "template/v1",
  "type": "onchain",
  "variables": {"owner_program": "bytes32", "exit_delay": "int", "max_fee": "int"},
  "inputs": [
    {
      "name": "deposit",
      "contract": {
        "definition": {
          "contractName": "DelegatedOnchainExit",
          "constructorInputs": [
            {"name": "ownerProgram", "type": "bytes32"},
            {"name": "exitDelay", "type": "int"},
            {"name": "maxFee", "type": "int"}
          ],
          "structs": [],
          "functions": [
            {
              "name": "exit",
              "arkade": {
                "inputs": [],
                "asm": [
                  "0",
                  "OP_INSPECTOUTPUTSCRIPTPUBKEY",
                  "1",
                  "OP_EQUALVERIFY",
                  "<ownerProgram>",
                  "OP_EQUALVERIFY",
                  "0",
                  "OP_INSPECTOUTPUTVALUE",
                  "<maxFee>",
                  "OP_ADD",
                  "OP_PUSHCURRENTINPUTINDEX",
                  "OP_INSPECTINPUTVALUE",
                  "OP_GREATERTHANOREQUAL"
                ]
              },
              "leaves": [
                {
                  "name": "exit",
                  "asm": ["<exitDelay>", "OP_CHECKSEQUENCEVERIFY", "OP_DROP", "<EMULATOR_KEY:exit>", "OP_CHECKSIG"],
                  "witness": [{"name": "emulatorSig", "type": "signature", "encoding": "schnorr-64", "injected": true}]
                }
              ]
            }
          ]
        },
        "arguments": {"ownerProgram": "<owner_program>", "exitDelay": "<exit_delay>", "maxFee": "<max_fee>"}
      },
      "spend": {"function": "exit", "leaf": "exit"}
    }
  ],
  "outputs": [
    {
      "name": "payout",
      "index": 0,
      "value": {"from": "deposit"},
      "locking": "5120<owner_program>"
    }
  ],
  "packets": {"output_index": 1},
  "fees": {"from": "deposit", "max": "<max_fee>"},
  "delegation": {"schedule": {"deposit": {"min_confirmations": 3}}}
}
